# James & Cristel Wedding Supabase Configuration
# Replace these with your actual Supabase project keys from your Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Note: The SQL schema with Row Level Security (RLS) is located at supabase/schema.sql
 
